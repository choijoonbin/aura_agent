APP_NAME=DWP Agent Runtime
APP_VERSION=0.2.0
DWP_AGENT_SERVICE_TOKEN=replace-with-managed-agent-service-secret
DWP_AGENT_IDENTITY_SIGNING_SECRET=replace-with-managed-gateway-agent-signing-secret
DWP_AGENT_IDENTITY_KEY_ID=gateway-agent-v1
SERVICE_GATEWAY_URL=http://localhost:8080
SERVICE_PLATFORM_URL=http://localhost:8002
DWP_PLATFORM_RUNTIME_SERVICE_TOKEN=replace-with-managed-platform-runtime-secret
DWP_APPROVAL_RUNTIME_SERVICE_TOKEN=replace-with-managed-approval-runtime-read-secret
DWP_AGENT_REGISTRY_MODE=enforced
DWP_AGENT_DATABASE_URL=postgresql://dwp_user:replace-with-managed-password@localhost:5432/dwp_agent
DWP_AGENT_DATABASE_REQUIRED=true
DWP_AGENT_QUESTION_LAUNCH_CLEANUP_SECONDS=60
# Runs the fenced Postgres artifact-export and active-store disposition workers.
# Keep disabled until the worker instance, database retention policy, and backup
# disposition procedure have been approved for the deployment.
DWP_GOVERNED_WORKERS_ENABLED=false
DWP_GOVERNED_WORKER_INTERVAL_SECONDS=1
DWP_AGENT_KEY_PROVIDER=managed
DWP_AGENT_KEY_REFERENCE=replace-with-kms-or-secret-manager-reference
DWP_AGENT_DATA_KEY_VERSION=2026-08-v1
# Local development only. Keep these values in an ignored .env.local or a
# chmod 600 file under .dev-runtime/keys; never enable them in dev/qa/prod.
# DWP_AGENT_KEY_PROVIDER=local-inline
# DWP_AGENT_DATA_KEY=replace-with-base64-encoded-32-byte-key
# DWP_AGENT_PREVIOUS_DATA_KEYS={}
# DWP_AGENT_KEY_PROVIDER=local-file
# DWP_AGENT_LOCAL_KEY_ROOT=.dev-runtime/keys
# DWP_AGENT_DATA_KEY_FILE=agent-data-key-v1.key
# DWP_AGENT_PREVIOUS_DATA_KEY_FILES={}
DWP_AGENT_PRIVACY_HASH_SECRET=replace-with-managed-hmac-secret
DWP_AGENT_SAFETY_SECRET=replace-with-managed-safety-id-secret
DWP_ENVIRONMENT=production
DWP_AGENT_LOCAL_ACTIVITY_SEED_ENABLED=false
DWP_AUDIT_COLLECTOR_URL=http://dwp-platform-server:8002/internal/audit/events
DWP_AUDIT_INGEST_TOKEN=replace-with-managed-audit-ingest-secret
DWP_API_HISTORY_COLLECTOR_URL=http://dwp-platform-server:8002/internal/observability/api-history
DWP_API_HISTORY_INGEST_TOKEN=replace-with-managed-history-ingest-secret
DWP_API_HISTORY_PRIVACY_HASH_SECRET=replace-with-managed-history-hmac-secret
DWP_MODEL_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=replace-with-managed-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://replace-with-resource.openai.azure.com
DWP_OPENAI_MODEL=replace-with-approved-deployment-name
DWP_MODEL_REGION=replace-with-approved-processing-region
DWP_AGENT_PRODUCT_AUTHORIZATION_V21_ENABLED=false
DWP_AGENT_PRODUCT_AUTHORIZATION_V22_ENABLED=false
DWP_AI_RUNTIME_CONTROL_ENFORCEMENT_ENABLED=false
# Public OpenAI alternative:
# DWP_MODEL_PROVIDER=openai
# OPENAI_API_KEY=replace-with-managed-openai-project-key
# DWP_OPENAI_BASE_URL=https://api.openai.com/v1
DWP_OPENAI_TIMEOUT_SECONDS=20
DWP_AGENT_STREAM_TIMEOUT_SECONDS=40
DWP_AGENT_STREAM_MAX_CONCURRENCY=8
DWP_OPENAI_MAX_OUTPUT_TOKENS=900
# Secure multimodal attachment pipeline. READY is emitted only after the broker
# independently verifies the object digest/size/MIME and every required stage.
DWP_ATTACHMENT_BROKER_ENABLED=false
DWP_ATTACHMENT_BROKER_BASE_URL=https://attachment-broker.internal
DWP_ATTACHMENT_BROKER_SERVICE_TOKEN=replace-with-managed-attachment-broker-secret
DWP_ATTACHMENT_BROKER_ALLOWED_HOSTS=attachment-broker.internal
DWP_ATTACHMENT_UPLOAD_ALLOWED_HOSTS=managed-upload.example.invalid
DWP_ATTACHMENT_BROKER_TIMEOUT_SECONDS=10
DWP_ATTACHMENT_MAXIMUM_FILE_BYTES=26214400
DWP_ATTACHMENT_ALLOWED_MEDIA_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg,text/plain,text/csv
DWP_ATTACHMENT_AV_AVAILABLE=false
DWP_ATTACHMENT_DLP_AVAILABLE=false
DWP_ATTACHMENT_PARSER_AVAILABLE=false
DWP_ATTACHMENT_OCR_AVAILABLE=false
DWP_ATTACHMENT_INDEX_AVAILABLE=false
DWP_ATTACHMENT_DELETE_AVAILABLE=false
# Deep Research and routine execution remain capability-gated. Enable only on a
# worker deployment with approved model/source routes and fenced DB access.
DWP_DEEP_RESEARCH_WORKER_ENABLED=false
DWP_ROUTINE_EXECUTION_WORKER_ENABLED=false
DWP_ROUTINE_EXECUTION_WORKER_INTERVAL_SECONDS=1
# Team artifact ACL broker. The API reports provider actions unavailable until
# its service identity and allowlisted endpoint pass configuration validation.
DWP_ARTIFACT_COLLABORATION_ENABLED=false
DWP_ARTIFACT_ACL_BROKER_BASE_URL=https://artifact-acl-broker.internal
DWP_ARTIFACT_ACL_BROKER_SERVICE_TOKEN=replace-with-managed-artifact-acl-secret
DWP_ARTIFACT_ACL_BROKER_ALLOWED_HOSTS=artifact-acl-broker.internal
DWP_ARTIFACT_ACL_BROKER_TIMEOUT_SECONDS=10
# Trusted worker observations are the only path to terminal control-plane success.
DWP_ADMIN_CONTROL_WORKER_TOKEN=replace-with-managed-admin-control-worker-secret
DWP_OUTCOME_PRIVACY_THRESHOLD=10
DWP_OUTCOME_CURRENCY=USD
# Voice is opt-in and uses a dedicated credential. Raw audio is processed
# ephemerally and is not stored by the Agent runtime.
DWP_DWAION_VOICE_ENABLED=false
DWP_DWAION_VOICE_PROVIDER=azure_openai
DWP_DWAION_VOICE_API_KEY=replace-with-managed-voice-provider-key
DWP_DWAION_VOICE_BASE_URL=https://replace-with-resource.openai.azure.com
DWP_DWAION_STT_MODEL=replace-with-approved-transcription-deployment
DWP_DWAION_TTS_MODEL=replace-with-approved-speech-deployment
DWP_DWAION_TTS_VOICE=coral
DWP_DWAION_VOICE_TIMEOUT_SECONDS=25
# Meeting intelligence is internal, zero-storage, and separately authorized.
# Keep disabled until the provider contract attests no training, no retention,
# an approved processing region, and a dedicated service-to-service credential.
DWP_MEETING_INTELLIGENCE_ENABLED=false
DWP_MEETING_INTELLIGENCE_SERVICE_TOKEN=replace-with-managed-meeting-intelligence-secret
DWP_MEETING_INTELLIGENCE_ASSERTION_SECRET_BASE64=replace-with-base64-managed-32-byte-secret
DWP_MEETING_INTELLIGENCE_ASSERTION_KEY_ID=meeting-workload-v1
DWP_MEETING_INTELLIGENCE_PROVIDER=azure_openai
DWP_MEETING_INTELLIGENCE_API_KEY=replace-with-managed-meeting-intelligence-provider-key
DWP_MEETING_INTELLIGENCE_BASE_URL=https://replace-with-resource.openai.azure.com
DWP_MEETING_INTELLIGENCE_MODEL=replace-with-approved-meeting-intelligence-deployment
DWP_MEETING_INTELLIGENCE_PROCESSING_REGION=replace-with-approved-region
DWP_MEETING_INTELLIGENCE_TRAINING_DISABLED=true
DWP_MEETING_INTELLIGENCE_RETENTION_DISABLED=true
# External governance issuer: compact dwpa1 payload, Ed25519 DER public key, and
# the exact approved provider-policy document SHA-256. Boolean flags alone do not enable egress.
DWP_MEETING_INTELLIGENCE_POLICY_ATTESTATION=replace-with-short-lived-signed-attestation
DWP_MEETING_INTELLIGENCE_ATTESTATION_PUBLIC_KEY_BASE64=replace-with-base64-ed25519-der-public-key
DWP_MEETING_INTELLIGENCE_ATTESTATION_KEY_ID=meeting-intelligence-policy-v1
DWP_MEETING_INTELLIGENCE_APPROVED_POLICY_SHA256=replace-with-lowercase-policy-sha256
DWP_MEETING_INTELLIGENCE_TIMEOUT_SECONDS=24
